# Copy to .env next to compose.yaml and change what you need; every line is optional and shows
# the default. See https://kd5ryn.github.io/b123d-print/getting-started/http/#settings-in-env
# B123D_PRINT_PUBLIC_URL=https://cad.example.com   # default: taken from each request
# B123D_PRINT_LISTEN=127.0.0.1:8000
# B123D_PRINT_IMAGE=ghcr.io/kd5ryn/b123d-print-mcp:latest
# B123D_PRINT_MAX_BUILDS=2                         # builds at once; a check also splits over this many
# B123D_PRINT_TIMEOUT=120                          # seconds per build, render, section or export
# B123D_PRINT_CHECK_TIMEOUT=300                    # seconds per check (returns what it found, near the end)
# B123D_PRINT_RETENTION_DAYS=30                    # remove a workspace unused this many days; 0 = never
# B123D_PRINT_PARTS=./parts
# B123D_PRINT_CONFIG=./config
# B123D_PRINT_UID=1000
# B123D_PRINT_GID=1000
