# Copy to .env next to compose.yaml and change what you need; every line is optional and shows
# the default. See https://kd5ryn.github.io/b123d-print/getting-started/http/#settings-in-env
# B123D_PRINT_PUBLIC_URL=https://cad.example.com   # default: taken from each request
# B123D_PRINT_LISTEN=127.0.0.1:8000
# B123D_PRINT_IMAGE=ghcr.io/kd5ryn/b123d-print-mcp:latest
# B123D_PRINT_MAX_BUILDS=2                         # builds at once, shared fairly between tokens; 3 on 4+ cores
# B123D_PRINT_QUICK_SLOTS=1                        # of those, kept for quick calls (measure, section, ...)
# B123D_PRINT_CLIENT_JOBS=4                        # calls per token running + waiting; more are refused; 0 = no cap
# B123D_PRINT_MAX_UPLOADS=8                        # signed-link uploads at once, all tokens; more are refused; 0 = no cap
# B123D_PRINT_CLIENT_UPLOADS=2                     # signed-link uploads at once per token; 0 = no cap
# B123D_PRINT_MAX_MEMORY=2g                        # memory per build; over it the build fails plainly; 0 = no limit
# B123D_PRINT_WORKER_MEMORY=6g                     # worker container limit: >= MAX_BUILDS x MAX_MEMORY + 1g
# B123D_PRINT_TIMEOUT=240                          # seconds per build, render, section or export
# B123D_PRINT_CHECK_TIMEOUT=300                    # seconds per check (returns what it found, near the end)
# B123D_PRINT_RETENTION_DAYS=30                    # remove a workspace unused this many days; 0 = never
# B123D_PRINT_PARTS=./parts
# B123D_PRINT_CONFIG=./config
# B123D_PRINT_UID=1000
# B123D_PRINT_GID=1000
